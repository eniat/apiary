{
  "uid": "apiary",
  "title": "apiary",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "internal",
        "label": "gateway address",
        "type": "textbox",
        "query": "172.30.0.1",
        "current": { "text": "172.30.0.1", "value": "172.30.0.1" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "fleet against load",
      "description": "honeypot count versus the signal that drives it",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "apiary_honeypots", "legendFormat": "{{state}}" },
        { "refId": "B", "expr": "apiary_unserved_flows", "legendFormat": "unserved" },
        { "refId": "C", "expr": "apiary_sessions", "legendFormat": "sessions" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "actions against promotions",
      "description": "the gap is the warm pool running dry",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum by (action) (increase(apiary_scaling_actions_total[1m]))", "legendFormat": "{{action}}" },
        { "refId": "B", "expr": "increase(apiary_promotion_seconds_count[1m])", "legendFormat": "promoted" },
        { "refId": "C", "expr": "increase(apiary_reaped_total[1m])", "legendFormat": "reaped" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "promotion latency",
      "description": "a map write against the cold start it replaced",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(apiary_promotion_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.9, sum by (le) (rate(apiary_promotion_seconds_bucket[5m])))", "legendFormat": "p90" },
        { "refId": "C", "expr": "histogram_quantile(1, sum by (le) (rate(apiary_promotion_seconds_bucket[5m])))", "legendFormat": "max" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "live fleet cpu",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "apiary_cpu_percent", "legendFormat": "cpu" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "live fleet memory",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "apiary_memory_bytes", "legendFormat": "memory" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "attacks over time",
      "description": "sessions opened, the readiness dial excluded",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "refId": "A", "queryType": "range", "expr": "sum by (honeypot) (count_over_time({job=\"apiary\"} | json | src_ip != \"$internal\" | class = \"session.open\" [$__auto]))", "legendFormat": "{{honeypot}}" }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "unique sources",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 16 },
      "targets": [
        { "refId": "A", "queryType": "instant", "instant": true, "expr": "count(count by (src_ip) (count_over_time({job=\"apiary\"} | json | src_ip != \"$internal\" [$__range])))" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "credential attempts",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "targets": [
        { "refId": "A", "queryType": "range", "expr": "sum(count_over_time({job=\"apiary\"} | json | class = \"auth.attempt\" [$__auto]))", "legendFormat": "attempts" }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "commands executed",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 24 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "queryType": "range", "expr": "{job=\"apiary\"} | json | class = \"command.input\"" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "events by class",
      "description": "one query across both honeypot types",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 33 },
      "targets": [
        { "refId": "A", "queryType": "range", "expr": "sum by (class) (count_over_time({job=\"apiary\"} | json [$__auto]))", "legendFormat": "{{class}}" }
      ]
    }
  ]
}
